# ─────────────────────────────────────────────────────────────────────────────
# KEDAI backend environment
#
# Copy to `.env` and adjust. Every value has a working default, so the API boots
# and serves a full demo dataset with no setup at all — no database required.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to send credentialed requests.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional. When set, /api/v1/health/ready reports "connected" instead of
# "demo-dataset". The API runs on its generated dataset either way; this only
# controls the readiness report and is what a future Prisma-backed store would use.
# DATABASE_URL="postgresql://kedai:kedai@localhost:5432/kedai?schema=public"

# Signs the short-lived access token. Always override in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Demo credentials, published by GET /api/v1/auth/demo-accounts.
DEV_STAFF_PIN=1234
DEV_MANAGER_PIN=2468
DEV_CUSTOMER_OTP=111111
